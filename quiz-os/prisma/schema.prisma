generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id            String   @id @default(cuid())
  slug          String   @unique // e.g. "sydney-gutters"
  name          String
  description   String?  // short subtitle shown on the client card e.g. "E-commerce Solutions"
  theme         Json     // { primary, secondary, font, radius, logoUrl }
  webhookUrl    String   // ENCRYPTED at rest — see lib/crypto.ts. Never returned to any client-side fetch.
  webhookSecret String?  // optional, used to HMAC-sign outgoing payloads so the receiver (n8n) can verify origin
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  quizzes Quiz[]

  @@index([slug])
}

model Quiz {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  slug      String   // e.g. "debt-consolidation"
  name      String
  schema    Json     // full quiz definition — steps, options, disqualify rules, endScreen (see lib/quiz-logic.ts for shape)
  status    String   @default("draft") // draft | live | paused
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions Submission[]

  @@unique([clientId, slug])
  @@index([clientId])
}

model Submission {
  id            String   @id @default(cuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers       Json
  utm           Json?
  disqualified  Boolean  @default(false)
  disqualifyMsg String?
  webhookStatus String   @default("pending") // pending | sent | failed | skipped (skipped = disqualified, never forwarded)
  webhookAttempts Int    @default(0)
  lastError     String?
  createdAt     DateTime @default(now())

  @@index([quizId])
  @@index([webhookStatus])
}
