# Postgres (shared VPS instance, new DB e.g. quizos)
DATABASE_URL="postgresql://user:pass@localhost:5432/quizos"

# Generate ONCE: openssl rand -hex 32
# Never rotate unless there's a breach. Same key for every client, forever.
WEBHOOK_ENCRYPTION_KEY=""

# Clerk (reuse your existing Coach OS Clerk project or make a new one)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin

# Optional, used only by prisma/seed.ts for local testing
SEED_WEBHOOK_URL=""

# Used to build public quiz links shown in the admin (Copy link, builder top bar)
NEXT_PUBLIC_SITE_URL="https://embed.hivesocial.com.au"
