# Postgres — dedicated container for this app, same pattern as your other apps
# (gingin-forecast-db, coach_os_postgres, hive_os_postgres). docker-compose.yml creates
# this container for you; POSTGRES_PASSWORD here sets its password, and DATABASE_URL
# below just needs to match it. No manual `docker exec ... CREATE DATABASE` step needed.
POSTGRES_PASSWORD="pick-a-strong-password"
DATABASE_URL="postgresql://quizos:pick-a-strong-password@quizos-db:5432/quizos"

# Generate ONCE: openssl rand -hex 32
# Never rotate unless there's a breach. Same key for every client, forever.
WEBHOOK_ENCRYPTION_KEY=""

# Clerk (reuse your existing Coach OS Clerk project or make a new one)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin

# Optional, used only by prisma/seed.ts for local testing
SEED_WEBHOOK_URL=""

# Single source of truth for the domain — used by docker-compose.yml's Traefik rule below
# AND by NEXT_PUBLIC_SITE_URL. Change it here once, not in multiple files.
APP_DOMAIN=embed.hivesocial.agency

# Used to build public quiz links shown in the admin (Copy link, builder top bar, embed snippets)
NEXT_PUBLIC_SITE_URL=https://embed.hivesocial.agency
